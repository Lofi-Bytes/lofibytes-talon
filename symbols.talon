# lofibytes: symbols
# Requires Talon Community.
os: mac
mode: command
-

(coal gap | coalgap): ": "

questo: "?"

deminus: " - "

deplush: " + "

tilde: "~"

clamor: "!"

banquall: " != "

(downscore | crunder): "_"

(semi | semicolon): ";"

percy: "%"

depercy: " % "

loco: "@"

damper: " & "

scampi: " && "

spike$: "|"

bartrap: "||"

goalpost: " || "

orquals: " ||= "

quatchet: "'"

quatches: "\""

swipe: ", "

skoosh: " "

divvy: " / "

shalls: "\\"

declangle: " < "

clangle: "<"

dewrangle: " > "

wrangle: ">"

rangrang: ">>"

coaltwice: "::"

mintwice: "--"

equeft: " = "

(longqual | long qual): " == "

trickle: " === "

shrocket: " => "

tinker: "`"

thrinket: "```"

smaqual: "="

minquall: " -= "

pluqual: " += "

lessqual: " <= "

grayqual: " >= "

divy: " / "

lambo: "->"

# Recovered familiar names.
dolly: "$"
(octo | thorpe): "#"
brackorp: "["
brackose: "]"
kirksorp: "{"
kirkos: "}"
derangle: " > "
doodle: ".."
plustwice: "++"
(ranqual | nockle): " !== "
starqual: " *= "
