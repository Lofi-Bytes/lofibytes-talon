# lofibytes: navigation
# Requires Talon Community.
os: mac
mode: command
-

ricky:
  edit.line_end()

ricksy:
  edit.extend_line_end()

lefty:
  edit.line_start()

lecksy:
  edit.extend_line_start()

olly:
  edit.select_all()

doomway:
  edit.file_end()

doom:
  edit.down()

jeepway:
  edit.file_start()

jeep:
  edit.up()

crimp:
  edit.left()

chris:
  edit.right()

shunkrim:
  edit.word_left()

shunkrish:
  edit.word_right()

shackle:
  edit.select_line()

shroomaway:
  edit.extend_file_end()

shroom:
  edit.extend_down()

shreepway:
  edit.extend_file_start()

shreep:
  edit.extend_up()

shrim:
  edit.extend_left()

shrish:
  edit.extend_right()

scram:
  edit.extend_word_left()

scrish:
  edit.extend_word_right()

# Preserve the newer forms too.
fame: edit.word_left()
fish: edit.word_right()
shroomway: edit.extend_file_end()
schrim: edit.extend_left()
