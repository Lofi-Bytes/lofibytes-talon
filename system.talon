# lofibytes: system
# Requires Talon Community.
os: mac
mode: command
-

quit app:
  key(cmd-q)

troll left:
  key(ctrl-left)

troll right:
  key(ctrl-right)

troll up:
  key(ctrl-up)

troll down:
  key(ctrl-down)

gibby:
  key(cmd-`)

shibby:
  key(cmd-shift-`)

preffies: app.preferences()
swick: key(cmd-tab)
